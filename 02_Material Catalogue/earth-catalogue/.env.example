# Copy this file to ".env" and fill it in. Never commit or share ".env".
GEMINI_API_KEY=paste-your-key-here

# Optional
# GEMINI_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite
# PORT=8000
# CATALOGUE_DATA=/path/to/where/you/want/the/data

# Optional: upload the Grasshopper export to Supabase Storage ("Publish to cloud" button)
# SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# SUPABASE_SERVICE_KEY=paste-the-secret-key-here
# SUPABASE_BUCKET=catalogue
